<resources>
    <style name="Theme.PocketDriver.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="colorPrimary">@color/app_primary</item>
        <item name="colorOnPrimary">@color/app_on_primary</item>
        <item name="colorPrimaryContainer">@color/app_badge</item>
        <item name="colorOnPrimaryContainer">@color/app_text</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_text</item>
        <item name="colorOnSurfaceVariant">@color/app_muted</item>
        <item name="colorOutline">@color/app_outline</item>
        <item name="colorError">@color/app_error</item>
        <item name="materialButtonStyle">@style/Widget.PocketDriver.Button</item>
    </style>
    <style name="Theme.WifiBluetoothRecorder" parent="Theme.PocketDriver.Base">
        <item name="android:navigationBarColor">@color/app_hero</item>
    </style>
    <style name="Widget.PocketDriver.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">10dp</item>
    </style>
    <style name="Widget.PocketDriver.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="strokeColor">@color/app_outline</item>
        <item name="android:textColor">@color/app_text</item>
        <item name="iconTint">@color/app_text</item>
        <item name="iconSize">20dp</item>
        <item name="iconPadding">10dp</item>
    </style>
    <style name="Text.PocketDriver.Title" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/app_text</item>
        <item name="android:letterSpacing">-0.025</item>
    </style>
    <style name="Text.PocketDriver.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/app_muted</item>
    </style>
    <style name="Text.PocketDriver.Label" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/app_muted</item>
    </style>
    <style name="Text.PocketDriver.Metric" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/app_text</item>
        <item name="android:fontFeatureSettings">tnum</item>
    </style>
    <style name="Widget.PocketDriver.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">24dp</item>
        <item name="cardBackgroundColor">@color/app_surface</item>
        <item name="strokeColor">@color/app_outline</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
    </style>
</resources>
